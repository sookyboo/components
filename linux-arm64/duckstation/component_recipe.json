{
  "duckstation": {
    "parent": "../../duckstation/component_recipe.json",
    "overrides": {
      "sources": {
        "app": {
          "set": {
            "source_url": "https://github.com/stenzek/duckstation/releases/download/{VERSION}/DuckStation-arm64.AppImage"
          },
          "assets": {
            "apprun_hooks": {
              "remove": true
            },
            "component_launcher": {
              "set": {
                "source": "$REPO_ROOT/linux-arm64/$COMPONENT_NAME/component_launcher.sh"
              }
            },
            "recipe_file": {
              "set": {
                "source": "$RESOLVED_RECIPE_FILE"
              }
            }
          }
        }
      }
    }
  }
}
