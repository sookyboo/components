{
  "rpcs3": {
    "parent": "../../rpcs3/component_recipe.json",
    "overrides": {
      "sources": {
        "app": {
          "set": {
            "source_url": "https://github.com/RPCS3/rpcs3-binaries-linux-arm64/releases/download/{VERSION}/*_linux_aarch64.AppImage"
          },
          "assets": {
            "recipe_file": {
              "set": {
                "source": "$RESOLVED_RECIPE_FILE"
              }
            }
          },
          "libs": {
            "libglew": {
              "remove": true
            },
            "libglu": {
              "remove": true
            },
            "libsdl3": {
              "remove": true
            }
          }
        }
      }
    }
  }
}
